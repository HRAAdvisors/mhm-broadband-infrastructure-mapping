# Mapbox GL JS access token (public — safe to expose client-side).
# https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Base URL the app fetches converted GeoJSON/tileset assets from.
# - Local dev without S3 set up yet: leave unset to fall back to /public/geojson
# - S3 + CloudFront: https://d111111abcdef8.cloudfront.net
# - S3 static website hosting: https://your-bucket.s3.amazonaws.com
NEXT_PUBLIC_DATA_BASE_URL=/geojson
